{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🛡️ Debug ScopeKernel App (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "scopekernel/ui/app.py", "--server.port", "8501"],
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "🧪 Debug Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "--tb=short"],
      "console": "integratedTerminal"
    },
    {
      "name": "⚡ Debug Launcher Script (run.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal"
    }
  ]
}
